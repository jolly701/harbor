+// Copilot emits a new item id on every Responses stream event. Codex keys
+// messages by that id, so one answer is rendered once per event.
+function stabilizeResponseEvent(event, itemIds) {
+	if (!event || typeof event !== "object") return event;
+	const index = event.output_index;
+	if (typeof index === "number") {
+		const stable = itemIds.get(index) || event.item_id || event.item?.id || `item_${index}`;
+		itemIds.set(index, stable);
+		if (event.item_id) event.item_id = stable;
+		if (event.item && typeof event.item === "object") event.item.id = stable;
+	}
+	const output = event.response?.output;
+	if (Array.isArray(output)) output.forEach((item, itemIndex) => {
+		if (!item || typeof item !== "object") return;
+		const stable = itemIds.get(itemIndex) || item.id;
+		if (!stable) return;
+		itemIds.set(itemIndex, stable);
+		item.id = stable;
+	});
+	return event;
+}
+function rewriteSseBlock(block, itemIds) {
+	return block.split("\n").map((line) => {
+		if (!line.startsWith("data:")) return line;
+		const raw = line.slice(5).trim();
+		if (!raw || raw === "[DONE]") return line;
+		try {
+			return `data: ${JSON.stringify(stabilizeResponseEvent(JSON.parse(raw), itemIds))}`;
+		} catch {
+			return line;
+		}
+	}).join("\n");
+}
+function stabilizeResponseStream(body) {
+	const reader = body.getReader();
+	const decoder = new TextDecoder();
+	const encoder = new TextEncoder();
+	const itemIds = new Map();
+	let pending = "";
+	return new ReadableStream({
+		async pull(controller) {
+			while (true) {
+				const { done, value } = await reader.read();
+				if (done) {
+					pending += decoder.decode();
+					if (pending.length > 0) controller.enqueue(encoder.encode(rewriteSseBlock(pending, itemIds)));
+					controller.close();
+					return;
+				}
+				pending += decoder.decode(value, { stream: true });
+				const parts = pending.split("\n\n");
+				pending = parts.pop() ?? "";
+				if (parts.length === 0) continue;
+				controller.enqueue(encoder.encode(`${parts.map((part) => rewriteSseBlock(part, itemIds)).join("\n\n")}\n\n`));
+				return;
+			}
+		}
+	});
+}
